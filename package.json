{
  "name": "luogusp",
  "version": "2.14.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "npm": "^12"
  },
  "scripts": {
    "release": "node scripts/publish.mjs",
    "publish": "node scripts/publish.mjs",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test",
    "quality": "node scripts/quality.mjs",
    "quality:check": "node scripts/quality.mjs --check",
    "quality:requires": "node scripts/quality.mjs --check --fetch-requires",
    "quality:report": "node scripts/quality.mjs --fetch-requires --write-report",
    "qa:prepare": "node scripts/prepare-browser-qa.mjs",
    "qa:browser": "node scripts/qa/browser-qa.mjs",
    "qa:hidden-intro:stage": "node scripts/qa/stage-hidden-intro.mjs",
    "qa:hidden-intro:verify": "node scripts/cdn/verify-production.mjs --qa",
    "benchmark:origins": "node scripts/benchmark-origins.mjs --write-report",
    "analyze:chunks": "node scripts/analyze-cdn-chunks.mjs --write-report",
    "cdn:build": "node scripts/cdn/build.mjs",
    "cdn:prepare": "node scripts/cdn/prepare.mjs",
    "cdn:publish": "node scripts/cdn/publish.mjs",
    "cdn:stage-userscript": "node scripts/cdn/stage-userscript.mjs",
    "cdn:verify": "node scripts/cdn/verify.mjs",
    "cdn:verify-production": "node scripts/cdn/verify-production.mjs",
    "renderer:build": "node scripts/renderer/build.mjs",
    "renderer:test": "node --test test/markdown-lite-baseline.test.mjs test/markdown-full.test.mjs test/markdown-renderer-api.test.mjs test/renderer-build.test.mjs",
    "renderer:check": "node scripts/renderer/check.mjs",
    "check": "npm run build:check && npm run quality:check && npm test"
  },
  "devDependencies": {
    "esbuild": "0.27.2",
    "jsdom": "29.1.1",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "highlight.js": "11.11.1",
    "katex": "0.18.1",
    "marked": "18.0.7"
  }
}
