{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "luogusp-cdn",
  "main": "worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "spcdn.betaoi.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "../../dist/cdn",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
